# --- Главный TG-бот (интерфейс) ---
BOT_TOKEN=
# Твой(и) Telegram user id. Узнать: напиши @userinfobot и он пришлёт.
# Можно перечислить несколько через запятую: OWNER_TG_ID=123456,789012
OWNER_TG_ID=

# --- Telethon userbot (для адаптера "Леонардо в TG") ---
# Получить: https://my.telegram.org/auth -> API development tools -> create application
TELETHON_API_ID=
TELETHON_API_HASH=
# Номер телефона аккаунта, которым userbot будет логиниться (с +)
TELETHON_PHONE=

# --- VK userbot (для адаптера "Леонардо в VK") ---
# Получить токен: https://vkhost.github.io/ или OAuth-флоу VK (scope=messages,offline).
VK_ACCESS_TOKEN=
# Короткое имя сообщества Леонардо в VK (то, что в URL: vk.com/<это>).
VK_LEONARDO_GROUP=dayvinchik

# --- VK Знакомства (адаптер "vk_dating", сервис vk.com/dating) ---
# Сервис работает на своём бэкенде dating.vk.ru, авторизация — по launch_url
# мини-приложения (подписанные VK launch-параметры). Токена из vkhost тут
# НЕДОСТАТОЧНО: launch_url можно снять только из браузерной сессии.
# Как достать (живёт ограниченное время — обновляй при ошибке launch_url_invalid):
#   1) открой vk.com/dating в браузере, F12 -> Network -> фильтр "signIn";
#   2) полистай пару анкет, найди запрос dating.vk.ru/api/auth.signIn;
#   3) вкладка Payload -> скопируй ЦЕЛИКОМ значение поля launch_url
#      (начинается с "?vk_access_token_settings=...&sign=...") сюда.
VK_DATING_LAUNCH_URL=
# Необязательно: _agent клиента. Если пусто — синтезируется автоматически.
VK_DATING_AGENT=
# Необязательно: id города для ленты. 0 = лента без фильтра по городу
# (адаптер берёт getRecommendedUsersSimple). Поставь числовой id города,
# только если хочешь фильтровать анкеты по конкретному городу.
VK_DATING_CITY_ID=0

# --- Gemini scorer (анализ профилей, сообщения к лайкам, расшифровка войсов) ---
# Получить: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Claude (Anthropic) — только автопереписка ---
# Получить: https://console.anthropic.com/ -> API Keys (ключ начинается с sk-ant-)
ANTHROPIC_API_KEY=
# claude-sonnet-4-6 (качество) или claude-haiku-4-5 (дешевле/быстрее)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Дефолтные настройки (можно менять прямо в боте через /goal, /threshold) ---
DEFAULT_THRESHOLD=70
DEFAULT_GOAL=Симпатичная девушка 18-30 лет, с интересными увлечениями, без перебора с макияжем.
SESSION_MAX_PROFILES=50
THROTTLE_MIN_SEC=3
THROTTLE_MAX_SEC=8
